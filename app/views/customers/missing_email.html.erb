<h1>Customers Missing Email</h1>

<nav>
  <%= link_to "All Customers", root_path %> |
  <%= link_to "Alphabetized Customers", customers_alphabetized_path %> |
  <%= link_to "Admin Dashboard", admin_root_path %>
</nav>

<% @customers.each do |customer| %>
  <%= render partial: "customer", locals: { customer: customer } %>
<% end %>

<% if @customers.empty? %>
  <p>No customers are missing email addresses.</p>
<% end %>
